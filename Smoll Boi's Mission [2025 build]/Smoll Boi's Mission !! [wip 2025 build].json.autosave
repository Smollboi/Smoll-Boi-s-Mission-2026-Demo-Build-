conditions":[{"type":{"value":"NumberVariable"},"parameters":["LoopIndex","<=","Object.PathfindingBehavior::NodeCount()-1"]}],"actions":[{"type":{"value":"PrimitiveDrawing::Circle"},"parameters":["ShapePainterObject","Object.PathfindingBehavior::GetNodeX(LoopIndex)","Object.PathfindingBehavior::GetNodeY(LoopIndex)","3"]}]},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Draw lines between nodes"},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["LoopIndex","<","Object.PathfindingBehavior::NodeCount()-1"]}],"actions":[{"type":{"value":"PrimitiveDrawing::LineV2"},"parameters":["ShapePainterObject","Object.PathfindingBehavior::GetNodeX(LoopIndex)","Object.PathfindingBehavior::GetNodeY(LoopIndex)","Object.PathfindingBehavior::GetNodeX(LoopIndex +1)","Object.PathfindingBehavior::GetNodeY(LoopIndex+1)","3"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["LoopIndex","+","1"]}]}]}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"DrawPathfinding::DrawPathfinding","type":"behavior"},{"description":"Pathfinding behavior","name":"PathfindingBehavior","supplementaryInformation":"PathfindingBehavior::PathfindingBehavior","type":"behavior"},{"description":"Shape painter used to draw the path","name":"ShapePainterObject","supplementaryInformation":"PrimitiveDrawing::Drawer","type":"objectList"}],"objectGroups":[]}],"propertyDescriptors":[{"value":"0","type":"Number","label":"LoopIndex","hidden":true,"name":"LoopIndex"},{"value":"","type":"Number","label":"","hidden":true,"name":"CorrectionX"},{"value":"","type":"Number","label":"","hidden":true,"name":"CorrectionY"}],"propertiesFolderStructure":{"folderName":"__ROOT","children":[{"propertyName":"LoopIndex"},{"propertyName":"Corre