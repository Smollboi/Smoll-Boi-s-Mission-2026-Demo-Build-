,"events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"ModVarScene"},"parameters":["__FollowObjects.MinX","=","min(Variable(__FollowObjects.MinX), Object.BoundingBoxLeft())"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"ModVarScene"},"parameters":["__FollowObjects.MaxX","=","max(Variable(__FollowObjects.MaxX), Object.BoundingBoxRight())"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"ModVarScene"},"parameters":["__FollowObjects.MinY","=","min(Variable(__FollowObjects.MinY), Object.BoundingBoxTop())"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"ModVarScene"},"parameters":["__FollowObjects.MaxY","=","max(Variable(__FollowObjects.MaxY), Object.BoundingBoxBottom())"]}]}]},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Move camera to the center location"},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"SetCameraX"},"parameters":["","=","lerp(CameraX(Object.Layer(), 0), (Variable(__FollowObjects.MinX) + Variable(__FollowObjects.MaxX)) / 2, Variable(__FollowObjects.LerpSpeed))","Object.Layer()","0"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"SetCameraY"},"parameters":["","=","lerp(CameraY(Object.Layer(), 0), (Variable(__FollowObjects.MinY) + Variable(__FollowObjects.MaxY)) / 2, Variable(__FollowObjects.LerpSpeed))","Object.Layer()","0"]}]},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Zoom in or out to keep all object instances on screen"},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"ModVarScene"},"parameters":["__FollowObjects.CameraWidth","=","abs(Variable(__FollowObjects.MaxX) - Variable(__FollowObjects.MinX)) + HorizontalBuffer * 2"]},{"type":{"value":"ModVarScene"},"parameters":["__FollowObjects.CameraHeight","=","abs(Variable(__FollowObjects.MaxY) - Variable(__FollowObjects.MinY)) + VerticalBuffer * 2"]},{"type":{"value":"ModVarScene"},"parameters":["__FollowObjects.CameraZoom","=","min(SceneWindowHeight() / Variable(__FollowObjects.CameraHeight), SceneWindowWidth() / Variable(__FollowObjects.CameraWidth))"]}]},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Adjust zoom to stay within min/max values"},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"ModVarScene"},"parameters":["__FollowObjects.CameraZoom","=","min(Variable(__FollowObjects.CameraZoom), Variable(__FollowObjects.MaxZoom))"]}]},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Change camera zoom"},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"ZoomCamera"},"parameters":["","lerp(CameraZoom(Object.Layer(), 0), Variable(__FollowObjects.CameraZoom), Variable(__FollowObjects.LerpSpeed))","Object.Layer()","0"]}]}],"parameters":[{"description":"Object (or Object group)","name":"Object","type":"objectList"},{"description":"Extra space on sides of screen","longDescription":"Each side will include this buffer","name":"HorizontalBuffer","type":"expression"},{"description":"Extra space on top and bottom of screen","longDescription":"Each side will include this buffer","name":"VerticalBuffer","type":"expression"},{"description":"Maximum zoom level (Default: 1)","longDescription":"Limit how far the camera will zoom in","name":"MaxZoom","type":"expression"},{"description":"Camera move speed (Range: 0 to 1) (Default: 0.05)","longDescription":"Percent of distance to destination that will be travelled each frame (used by lerp function)","name":"LerpSpeed","type":"expression"}],"objectGr